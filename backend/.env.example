# WorldPlate Restaurant Booking API - Environment Variables Example
# Copy this file to .env or configure these variables in Render Dashboard

PORT=3001
NODE_ENV=production

# Turso Cloud Database Credentials (Required for Production)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# Admin Security Key (Change to a strong random string)
ADMIN_API_KEY=worldplate-admin-change-me

# CORS Allowed Origins (Comma-separated URLs, or * for all)
CORS_ORIGIN=https://worldplate.netlify.app,http://localhost:5500,http://localhost:3001

# Razorpay Credentials (Test mode: rzp_test_... / Live mode: rzp_live_...)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Email Configuration (Gmail SMTP using Google App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Restaurant Details
RESTAURANT_NAME=WorldPlate
RESTAURANT_OPEN_HOUR=10
RESTAURANT_CLOSE_HOUR=23
TIMEZONE=Asia/Kolkata
